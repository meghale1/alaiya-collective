---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<video class="hero-video" autoplay muted loop playsinline>
					<source src="/hero.mp4" type="video/mp4" />
				</video>
				<div class="hero-overlay"></div>
				<div class="hero-text">
					<p class="eyebrow">OPEN TO OPPORTUNITIES</p>
					<h1 id="tagline" data-text="innovation grounded in reality"></h1>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const el = document.getElementById('tagline');
			const text = el.dataset.text;
			let i = 0;
			function type() {
				if (i <= text.length) {
					el.textContent = text.slice(0, i);
					i++;
					setTimeout(type, 60);
				}
			}
			type();
		</script>
	</body>
</html>

<style>
	:global(main) {
		width: 100%;
		max-width: none;
		padding: 0;
	}
	:global(header) {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		background: transparent !important;
		box-shadow: none !important;
		z-index: 10;
	}
	:global(header a) {
		color: white !important;
	}
	.hero {
		position: relative;
		height: 100vh;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: white;
	}
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.35);
	}
	.hero-text {
		position: relative;
		z-index: 2;
		max-width: 800px;
		padding: 0 1.5rem;
	}
	.eyebrow {
		letter-spacing: 0.3em;
		font-size: 0.85rem;
		margin-bottom: 1rem;
		color: rgba(255, 255, 255, 0.8);
	}
	h1 {
		color: white;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 400;
		min-height: 2.5em;
	}
</style>
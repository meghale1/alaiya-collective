---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlusMenu from '../components/PlusMenu.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact | Alaiya Development Collective" description="Get in touch with Alaiya Development Collective." />
	</head>
	<body>
		<Header />
		<PlusMenu />
		<main class="contact">
			<div class="text">
				<p class="label">CONTACT</p>
				<h1>Tell us about your project.</h1>
				<p class="lead">Working on something in climate, sustainability, or development? Send a few lines and we'll get back to you.</p>
				<ul class="details">
					<li>
						<span>EMAIL</span>
						<a href="mailto:meghan@alaiyacollective.com">meghan@alaiyacollective.com</a>
					</li>
					<li>
						<span>FOLLOW</span>
						<div class="icons">
							<a href="https://linkedin.com/company/alaiya-collective" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
							</a>
							<a href="https://instagram.com/alaiyacollective" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
							</a>
							<a href="https://youtube.com/@alaiyacollective" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
							</a>
						</div>
					</li>
				</ul>
			</div>

			<form id="contact-form" class="form">
				<input type="hidden" name="access_key" value="4bc5d65e-3f21-48f2-b86a-41c351cfed71" />
				<input type="hidden" name="subject" value="New message from alaiyacollective.com" />
				<input type="hidden" name="from_name" value="Alaiya Development Collective website" />
				<input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

				<label>YOUR NAME<input type="text" name="name" required /></label>
				<label>YOUR EMAIL<input type="email" name="email" required /></label>
				<label>MESSAGE<textarea name="message" rows="7" required></textarea></label>

				<button type="submit" class="send" id="send">SEND</button>
				<p id="form-status" class="status" role="status"></p>
			</form>
		</main>
		<Footer />

		<script>
			const form = document.getElementById('contact-form');
			const statusEl = document.getElementById('form-status');
			const sendBtn = document.getElementById('send');
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				sendBtn.disabled = true;
				statusEl.textContent = 'Sending...';
				try {
					const data = Object.fromEntries(new FormData(form));
					const res = await fetch('https://api.web3forms.com/submit', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify(data),
					});
					const result = await res.json();
					if (result.success) {
						form.reset();
						statusEl.textContent = 'Thanks, your message is on its way.';
					} else {
						statusEl.textContent = 'Something went wrong. Please email us directly instead.';
					}
				} catch (err) {
					statusEl.textContent = 'Something went wrong. Please email us directly instead.';
				}
				sendBtn.disabled = false;
			});
		</script>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		padding: 0;
		background: white;
		color: #111;
		font-family: 'Noto Serif', serif;
	}
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 5rem;
		width: auto;
		max-width: 1150px;
		margin: 0 auto;
		padding: 5rem 2rem 6rem;
		box-sizing: border-box;
	}
	.label {
		font-family: 'Inter', sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		margin: 0 0 1.5rem;
	}
	h1 {
		font-size: clamp(2rem, 4vw, 3.2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
		margin: 0 0 1.5rem;
	}
	.lead {
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 40ch;
		margin: 0 0 2.5rem;
	}
	.details {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.details li {
		display: grid;
		grid-template-columns: 6rem 1fr;
		align-items: center;
		padding: 0.8rem 0;
		border-top: 1px solid #111;
		font-size: 0.9rem;
	}
	.details li:last-child {
		border-bottom: 1px solid #111;
	}
	.details span {
		font-family: 'Inter', sans-serif;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}
	.details a {
		color: #111;
	}
	.icons {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.icons a {
		display: inline-flex;
		color: #111;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.form label {
		display: block;
		font-family: 'Inter', sans-serif;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}
	.form input[type='text'],
	.form input[type='email'],
	.form textarea {
		display: block;
		width: 100%;
		box-sizing: border-box;
		background: #f4f4f1;
		border: 1px solid #111;
		border-radius: 6px;
		color: #111;
		font-family: 'Noto Serif', serif;
		font-size: 1rem;
		padding: 0.75rem 0.9rem;
		margin-top: 0.4rem;
		outline: none;
		resize: vertical;
	}
	.form input:focus,
	.form textarea:focus {
		background: white;
		border-width: 2px;
		padding: calc(0.75rem - 1px) calc(0.9rem - 1px);
	}
	.send {
		align-self: flex-start;
		background: #304334;
		color: white;
		border: none;
		font-family: 'Inter', sans-serif;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		padding: 0.7rem 1.2rem;
		cursor: pointer;
	}
	.send:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.hp {
		display: none;
	}
	.status {
		font-size: 0.9rem;
		margin: 0;
		min-height: 1.2em;
	}

	@media (max-width: 800px) {
		.contact {
			grid-template-columns: 1fr;
			gap: 3rem;
			padding: 3rem 1.25rem 4rem;
		}
	}
</style>
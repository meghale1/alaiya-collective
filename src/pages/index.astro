---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header variant="landing" />
		<main>
			<section class="hero">
				<video class="hero-video" autoplay muted loop playsinline>
					<source src="/hero.mp4" type="video/mp4" />
				</video>
				<div class="hero-overlay"></div>
				<div class="hero-text">
					<h1 id="tagline" data-text="ALAIYA DEVELOPMENT COLLECTIVE" aria-label="Alaiya Development Collective"></h1>
					<p class="eyebrow">innovation grounded in reality</p>
				</div>
			</section>

			<section class="intro">
				<p class="label">WHAT WE DO</p>
				<p class="intro-text">
					Alaiya Development Collective does research, data analysis, geospatial mapping, and impact communications for organizations working on climate, sustainability, and international development. We turn raw data into findings people can use and explain them in plain language, so decision-makers, communities, and funders know what to do next.
				</p>

				<div class="services">
					<div class="service">
						<p class="label">01</p>
						<h3>Research</h3>
						<p>Policy and field research on topics like circular economy, supply chains, and waste systems.</p>
					</div>
					<div class="service">
						<p class="label">02</p>
						<h3>Data analysis</h3>
						<p>Using survey data, climate trends, and program records to show what is working and what isn't.</p>
					</div>
					<div class="service">
						<p class="label">03</p>
						<h3>Geospatial mapping</h3>
						<p>GIS maps and spatial analysis that show where problems and opportunities are.</p>
					</div>
					<div class="service">
						<p class="label">04</p>
						<h3>Impact communications</h3>
						<p>Reports, visuals, and stories that explain results to funders and communities.</p>
					</div>
				</div>
			</section>

			<section class="work">
				<div class="work-inner">
					<p class="work-label">SELECTED WORK</p>
					<h2 class="work-title">Recent projects</h2>

					<div class="cards">
						<a href="/projects" class="card">
							<div class="card-image" style="background-image: url('/project-1.jpg');">
								<span class="card-number">01</span>
							</div>
							<p class="card-name">Waste management pilot</p>
							<p class="card-place">Lamjung, Nepal</p>
						</a>
						<a href="/projects" class="card">
							<div class="card-image" style="background-image: url('/project-2.jpg');">
								<span class="card-number">02</span>
							</div>
							<p class="card-name">Lettuce supply chains</p>
							<p class="card-place">California, USA</p>
						</a>
						<a href="/projects" class="card">
							<div class="card-image" style="background-image: url('/project-3.jpg');">
								<span class="card-number">03</span>
							</div>
							<p class="card-name">Circular economy research</p>
							<p class="card-place">Mexico</p>
						</a>
					</div>
				</div>
			</section>

			<section class="cta">
				
				<h2 class="cta-title">Working on something?</h2>
				<p class="cta-text">Tell me about your project and we'll figure out where to start.</p>
				<a href="/contact" class="cta-button">Connect with me &rarr;</a>
			</section>
		</main>
		<Footer />

		<script>
			const el = document.getElementById('tagline');
			const lines = el.dataset.text.split('|');
			const letters = [];

			lines.forEach((line, n) => {
				if (n > 0) {
				el.appendChild(document.createTextNode(' '));
				el.appendChild(document.createElement('br'));
				}
				const words = line.split(' ');
				words.forEach((word, w) => {
					const wordEl = document.createElement('span');
					wordEl.className = 'word';
					word.split('').forEach((ch) => {
						const s = document.createElement('span');
						s.className = 'ch';
						s.textContent = ch;
						wordEl.appendChild(s);
						letters.push(s);
					});
					el.appendChild(wordEl);
					if (w < words.length - 1) el.appendChild(document.createTextNode(' '));
				});
			});

			let i = 0;
			function type() {
				if (i < letters.length) {
					if (i > 0) letters[i - 1].classList.remove('last');
					letters[i].classList.add('shown', 'last');
					i++;
					setTimeout(type, 65);
				}
			}
			type();
		</script>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		padding: 0;
		overflow-x: hidden;
	}
	:global(html) {
		scrollbar-width: none;
	}
	:global(html::-webkit-scrollbar) {
		display: none;
	}
	:global(main) {
		width: 100%;
		max-width: none;
		padding: 0;
	}
	:global(header) {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		box-sizing: border-box;
		padding: 1.5rem 2rem;
		background: transparent !important;
		box-shadow: none !important;
		z-index: 10;
	}
	:global(header a) {
		color: white !important;
	}
	.hero {
	position: relative;
	height: 100vh;
	height: 100svh;
	overflow: hidden;
	display: flex;
	align-items: center;
	justify-content: center;
	color: white;
}
.hero-text {
	position: relative;
	z-index: 2;
	width: 100%;
	box-sizing: border-box;
	padding: 0 2rem;
	margin: 0rem 0 0 0%;
}
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.35);
	}
	.eyebrow {
		font-family: 'Inter', sans-serif;
		font-size: 1rem;
		letter-spacing: 0.02em;
		text-align: center;
		color: rgba(255, 255, 255, 0.9);
		white-space: nowrap;
		margin: 1rem 0 0;
}
	h1 {
	color: white;
	font-family: 'Inter', sans-serif;
	font-size: 5.3vw;
	font-weight: 700;
	letter-spacing: -0.03em;
	line-height: 1;
	text-align: center;
	margin: 0;
}
:global(#tagline br) {
	display: none;
}
@media (max-width: 700px) {
	h1 {
		font-size: 7vw;
	}
	:global(#tagline br) {
		display: inline;
	}
}
	:global(.word) {
		display: inline-block;
		white-space: nowrap;
	}
	:global(.ch) {
		position: relative;
		opacity: 0;
	}
	:global(.ch.shown) {
		opacity: 1;
	}
	:global(.ch.last)::after {
		content: '';
		position: absolute;
		right: -5px;
		top: 0.25em;
		width: 3px;
		height: 0.9em;
		background: white;
		animation: blink 1s step-end infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.intro {
		max-width: 1100px;
		margin: 0 auto;
		padding: 6rem 2rem;
		color: #111;
		text-align: left;
	}
	.label {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: #111;
		margin: 0 0 1.5rem;
	}
	.intro-text {
		font-size: clamp(1.5rem, 3vw, 2.4rem);
		line-height: 1.3;
		color: #111;
		margin: 0 0 5rem;
	}
	.services {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2.5rem;
		border-top: 1px solid #111;
		padding-top: 2rem;
	}
	.service h3 {
		font-size: 1.1rem;
		font-weight: 600;
		color: #111;
		margin: 0 0 0.75rem;
	}
	.service p {
		font-size: 0.95rem;
		line-height: 1.5;
		color: #111;
		margin: 0;
	}
	.service .label {
		margin-bottom: 1rem;
	}

	.work {
		background: #000;
		color: white;
		padding: 6rem 2rem;
	}
	.work-inner {
		max-width: 1100px;
		margin: 0 auto;
	}
	.work-label {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 1rem;
	}
	.work-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 400;
		color: white;
		margin: 0 0 3rem;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 2rem;
	}
	.card {
		display: block;
		text-decoration: none;
		color: white;
	}
	.card-image {
		position: relative;
		aspect-ratio: 4 / 5;
		border-radius: 18px;
		background-color: #1a1a1a;
		background-size: cover;
		background-position: center;
		margin-bottom: 1rem;
		overflow: hidden;
	}
	.card-number {
		position: absolute;
		top: 1rem;
		left: 1.25rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.6);
	}
	.card-name {
		font-size: 1.05rem;
		color: white;
		margin: 0 0 0.25rem;
	}
	.card-place {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.6);
		margin: 0;
	}

	.cta {
		background: #f8f8f8;
		text-align: center;
		padding: 6rem 2rem;
	}
	.pill {
		display: inline-block;
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		color: #666;
		background: #ececec;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		margin: 0 0 1.5rem;
	}
	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 400;
		color: #111;
		margin: 0 0 0.75rem;
	}
	.cta-text {
		font-size: 1rem;
		color: #666;
		margin: 0 0 2rem;
	}
	.cta-button {
		display: inline-block;
		background: #0a0a0a;
		color: white;
		text-decoration: none;
		padding: 1rem 2rem;
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 600;
	}
</style>
---
const { variant = 'interior' } = Astro.props;
---

<header class={variant}>
	{variant === 'landing' ? (
		<nav class="landing-nav">
			<a href="/" class="logo-link">
				<img src="/logo.png" alt="Alaiya Development Collective" class="logo" />
			</a>
			<a href="/explore" class="box">EXPLORE</a>
		</nav>
	) : (
		<nav class="interior-nav">
			<div class="side">
				<a href="/">HOME</a>
				<a href="/explore#about" data-panel="about">ABOUT</a>
			</div>
			<a href="/" class="center-name">Alaiya Collective</a>
			<div class="side">
				<a href="/explore#projects" data-panel="projects">PROJECTS</a>
				<a href="/explore#contact" data-panel="contact">CONTACT</a>
			</div>
		</nav>
	)}
</header>

<style>
	header {
		font-family: 'Inter', sans-serif;
		font-weight: 700;
		margin: 0;
		background: white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
	}
	header.landing {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		box-sizing: border-box;
		padding: 0.75rem 2rem 0 1.5rem;
		background: transparent;
		box-shadow: none;
		z-index: 10;
	}
	.landing-nav {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}
	.logo-link {
		display: flex;
		align-items: center;
	}
	.logo {
		height: 96px;
		width: auto;
		display: block;
		margin-top: 0px;
	}
	.box {
		background: white;
		color: #111;
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-decoration: none;
		padding: 0.5rem 0.8rem;
		margin-top: 1.25rem;
	}
	header.landing a.box {
	color: #111 !important;
	font-weight: 900;
	}
	.interior-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 1.25rem 2rem;
	}
	.side {
		display: flex;
		justify-content: space-around;
		padding: 0 3rem;
	}
	.side a {
		color: #111;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-decoration: none;
	}
	.center-name {
		color: #111;
		font-size: 1.1rem;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
</style>
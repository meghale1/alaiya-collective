---
const pitch = 'Working on something in climate or development? Tell us about it and we’ll figure out where to start.';

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about' },
	{ label: 'Projects', href: '/projects' },
	{ label: 'Contact', href: '/contact' },
];

const icons = {
	mail: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>',
	linkedin:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>',
	instagram:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>',
	youtube:
		'<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
};

// Replace the Instagram address below with your real profile link.
const socials = [
	{ label: 'Email', icon: icons.mail, href: 'mailto:meghan@alaiyacollective.com', external: false },
	{ label: 'LinkedIn', icon: icons.linkedin, href: 'https://www.linkedin.com/company/alaiya-collective/', external: true },
	{ label: 'Instagram', icon: icons.instagram, href: 'https://www.instagram.com/YOUR-HANDLE/', external: true },
	{ label: 'YouTube', icon: icons.youtube, href: 'https://www.youtube.com/@alaiyacollective', external: true },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<div class="top">
			<p class="name">Alaiya Development Collective</p>
			<div class="connect">
				<p class="pitch">{pitch}</p>
				<a href="/contact" class="box">CONNECT WITH US</a>
			</div>
		</div>

		<div class="bottom">
			<ul class="links">
				{links.map((l) => (
					<li><a href={l.href}>{l.label}</a></li>
				))}
			</ul>
			<ul class="icons">
				{socials.map((s) => (
					<li>
						<a
							href={s.href}
							target={s.external ? '_blank' : undefined}
							rel={s.external ? 'noopener noreferrer' : undefined}
							aria-label={s.label}
							set:html={s.icon}
						/>
					</li>
				))}
			</ul>
		</div>

		<p class="copy">© {year} Alaiya Development Collective</p>
	</div>
</footer>

<style>
	.site-footer {
		background: #111;
		color: white;
		font-family: 'Inter', sans-serif;
		font-size: 1rem;
		line-height: 1.5;
		text-align: left;
		padding: 3.5rem 2rem 1.5rem;
		box-sizing: border-box;
	}
	.inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
		padding-bottom: 2.5rem;
	}
	.name {
		margin: 0;
		color: white;
		font-size: 0.85rem;
		font-weight: 600;
	}

	/* Pushed to the far right */
	.connect {
		margin-left: auto;
		max-width: 20rem;
	}
	.pitch {
		margin: 0 0 1rem;
		color: white;
		font-family: 'Noto Serif', serif;
		font-size: 0.85rem;
		line-height: 1.5;
	}
	.box {
		display: inline-block;
		background: white;
		color: #111;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-decoration: none;
		padding: 0.5rem 0.8rem;
	}
	.box:hover {
		background: #e6e6e6;
		color: #111;
	}

	/* Bottom row: site links left, four icons right */
	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.25);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.links a {
		color: white;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.links a:hover {
		color: white;
		text-decoration: underline;
	}
	.icons {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.icons a {
		display: inline-flex;
		color: white;
		text-decoration: none;
		opacity: 0.9;
	}
	.icons a:hover {
		opacity: 1;
	}
	.copy {
		margin: 1.5rem 0 0;
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.65rem;
	}

	@media (max-width: 700px) {
		.site-footer {
			padding: 3rem 1.5rem 1.5rem;
		}
		.top {
			flex-direction: column;
		}
		.connect {
			margin-left: 0;
			max-width: none;
		}
		.bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>